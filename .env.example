# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development                         # development | staging | production
APP_BASE_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://botforge:password@localhost:5432/botforge_dev

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace_with_random_32_byte_secret
# Token lifetime in seconds
SESSION_TTL_SECONDS=604800                  # 7 days

# ─── Discord OAuth ────────────────────────────────────────────────────────────
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3001/api/v1/integrations/discord/callback

# ─── Discord Bot (platform bot — used for server installation flow) ────────────
DISCORD_BOT_TOKEN=your_platform_bot_token

# ─── AI Provider ──────────────────────────────────────────────────────────────
AI_PROVIDER=anthropic
AI_API_KEY=your_anthropic_api_key
AI_DEFAULT_MODEL=claude-sonnet-5-5

# ─── Billing ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_STARTER_PRICE_ID=price_replace_me
STRIPE_PRO_PRICE_ID=price_replace_me

# ─── Encryption ───────────────────────────────────────────────────────────────
# Used to encrypt Discord tokens at rest — generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace_with_random_32_byte_secret

# ─── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=replace_me
EMAIL_FROM=BotForge <noreply@example.com>

# ─── Runtime (used by services/bot-runtime) ───────────────────────────────────
# Which bot instance this runtime process is managing
ACTIVE_BOT_INSTANCE_ID=

# ─── Twitch (for twitch_notifications module) ─────────────────────────────────
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
