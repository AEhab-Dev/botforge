{
  "name": "botforge",
  "private": true,
  "version": "0.1.0",
  "description": "BotForge — managed Discord bot platform",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @botforge/api db:generate",
    "db:migrate": "pnpm --filter @botforge/api db:migrate",
    "db:seed": "pnpm --filter @botforge/api db:seed",
    "db:studio": "pnpm --filter @botforge/api db:studio"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "modules/*"
  ],
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "@types/node": "^22.7.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.1"
}
